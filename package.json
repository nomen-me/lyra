{
  "name": "lyra-central-api",
  "version": "0.1.0",
  "description": "API Central da Lyra — IA da Synapse (Nomen Tecnologia). Orquestra chat via Gemini Flash, function calling e billing por tenant.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "tenant:add": "node scripts/provision-tenant.js",
    "tenant:rotate": "node scripts/rotate-tenant-key.js",
    "client:onboard": "bash scripts/onboard-client.sh",
    "deploy:install": "bash scripts/install.sh",
    "deploy:update": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "express": "^4.19.2",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "@google/genai": "^1.0.0",
    "uuid": "^9.0.1",
    "helmet": "^7.1.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
