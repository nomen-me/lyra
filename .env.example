# ── Servidor ──────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# ── Gemini / Vertex AI ────────────────────────────────────
# Dev/testes: chave do tier gratuito do Google AI Studio.
# Produção: chave pay-as-you-go do Google Cloud / Vertex AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Secret Manager (produção) ─────────────────────────────
# Quando ativo, GEMINI_API_KEY e as API Keys por tenant são
# resolvidas via Secret Manager, não via .env.
SECRETS_PROVIDER=env
# SECRETS_PROVIDER=gcp_secret_manager
# SECRETS_PROVIDER=vault
GCP_PROJECT_ID=
VAULT_ADDR=
VAULT_TOKEN=

# ── Administração (onboarding de clientes) ────────────────
# Chave usada SÓ pelo scripts/onboard-client.sh para provisionar
# tenants via /admin/tenants. Gere com: openssl rand -hex 32
# NUNCA distribua esta chave para VPS de cliente — ela não é uma
# API Key de tenant, é a chave que cria API Keys de tenant.
ADMIN_API_KEY=

# ── Redis (rate limiting + billing) ───────────────────────
REDIS_URL=redis://localhost:6379

# ── Billing / Cota ─────────────────────────────────────────
TOKENS_PER_ATTENDANCE=1000
RECARGAS_MAXIMAS_MES=3

# ── Rate limiting ──────────────────────────────────────────
# Requisições permitidas por tenant/token, por janela deslizante.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# ── Timeouts do fluxo síncrono (ms) ───────────────────────
TIMEOUT_CONSULTAR_FRETE_MS=5000
TIMEOUT_CONSULTAR_SALDO_MS=4000
TIMEOUT_CONSULTAR_ESTOQUE_MS=4000
